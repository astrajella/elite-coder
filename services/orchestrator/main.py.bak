@app.delete('/admin/runs/{run_id}')
async def admin_purge_run(run_id: str, dep=Depends(auth_dependency)):
    # Cautious purge: remove steps, leases, executions for run_id
    try:
        import aiosqlite, time
        db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
        async with aiosqlite.connect(db_path) as db:
            await db.execute("DELETE FROM run_steps WHERE run_id=?", (run_id,))
            await db.execute("DELETE FROM leases WHERE run_id=?", (run_id,))
            await db.execute("DELETE FROM executions WHERE run_id=?", (run_id,))
            await db.commit()
        return {"ok": True, "purged": run_id}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post('/admin/compact')
async def admin_compact(dep=Depends(auth_dependency)):
