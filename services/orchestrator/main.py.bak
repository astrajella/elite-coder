# Prometheus metrics
ORCH_TOOL_CALLS = Counter("orchestrator_tool_calls_total","Tool invocations",["tool","persona","status"])
ORCH_STEP_LATENCY = Histogram("orchestrator_step_seconds","Per-step latency seconds",["step"])
ORCH_RUN_ERRORS = Counter("orchestrator_errors_total","Orchestrator errors",["endpoint"])

@app.post('/orchestrate')
async def orchestrate(request: Request, background_tasks: BackgroundTasks):
    require_api_key(request)
    body = await request.json()
    try:
        plan_obj = PlanSchema(**body.get('plan'))
    except Exception as e:
        raise HTTPException(status_code=400, detail=f'Invalid plan: {e}')
    plan = plan_obj.dict() or body
    run_id = str(uuid.uuid4())
    # create initial run entry
    store.save_run(run_id, plan, 'pending', {'steps': []})
    # schedule background execution
    async def _run():
        await queue_run(run_id, plan)
    loop = asyncio.get_event_loop()
    loop.create_task(_run())
    return {'run_id': run_id, 'status': 'scheduled'}

@app.get('/runs/{run_id}')
async def get_run(run_id: str):
    r = store.get_run(run_id)
    if not r: raise HTTPException(status_code=404, detail='not found')
    return r

@app.get('/runs/stream/{run_id}')
async def stream_run(run_id: str):
    async def event_stream():
        import time
        while True:
            r = store.get_run(run_id)
            if not r:
                yield f"data: {json.dumps({'error':'not found'})}\n\n"
                return
            yield f"data: {json.dumps(r)}\n\n"
            if r.get('state') in ('succeeded','failed'):
                return
            await asyncio.sleep(1.0)
    return StreamingResponse(event_stream(), media_type='text/event-stream')

@app.get('/stats')
async def stats():
    # basic stats: count runs by state
    import sqlite3
    db = os.getenv('ORCH_DB','./services/orchestrator/orch_runs.db')
    conn = sqlite3.connect(db); cur = conn.cursor(); cur.execute("SELECT state, COUNT(*) FROM runs GROUP BY state"); rows = cur.fetchall(); conn.close()
    return {r[0]: r[1] for r in rows}



from fastapi.responses import StreamingResponse
import io, csv, math

@app.get('/runs/{run_id}/export_csv')
async def export_csv(run_id: str):
    r = store.get_run(run_id)
    if not r:
        raise HTTPException(status_code=404, detail='not found')
    # Build CSV: step_id,description,persona,tool,status,started_at,ended_at,duration_seconds,tokens,cost
    output = io.StringIO()
    writer = csv.writer(output)
    writer.writerow(['step_id','description','persona','tool','status','started_at','ended_at','duration_seconds','tokens','cost'])
    for s in (r.get('trace',{}) or {}).get('steps', []):
        step_id = s.get('step_id') or ''
        desc = s.get('description','')
        persona = s.get('persona') or (s.get('result',{}).get('response',{}).get('persona') if s.get('result') else '')
        tool = s.get('tool') or (s.get('result',{}).get('response',{}).get('tool') if s.get('result') else '')
        status = s.get('status','')
        started = s.get('started_at') or ''
        ended = s.get('ended_at') or ''
        duration = ''
        # prefer reported duration from result if available
        if s.get('result') and isinstance(s['result'], dict):
            duration = s['result'].get('duration') or ''
        if not duration and started and ended:
            try:
                duration = float(ended) - float(started)
            except Exception:
                duration = ''
        tokens = ''
        cost = ''
        if s.get('result') and isinstance(s['result'], dict):
            resp = s['result'].get('response') or {}
            tokens = resp.get('tokens') or resp.get('token_est') or ''
            cost = resp.get('cost') or resp.get('cost_est') or ''
        writer.writerow([step_id, desc, persona, tool, status, started, ended, duration, tokens, cost])
    output.seek(0)
    headers = {'Content-Disposition': f'attachment; filename="run_{run_id}_metrics.csv"'}
    return StreamingResponse(output, media_type='text/csv', headers=headers)


@app.post('/runs/{run_id}/resume')
async def resume_run(run_id: str, background_tasks: BackgroundTasks, request: Request):
    require_api_key(request)
    r = store.get_run(run_id)
    if not r: raise HTTPException(status_code=404, detail='not found')
    if r.get('state') in ('succeeded','running'):
        return {'ok': False, 'message': 'cannot resume in state '+r.get('state')}
    # schedule background execution from stored plan
    async def _run():
        await execute_plan(run_id, r.get('plan'))
    loop = asyncio.get_event_loop(); loop.create_task(_run())
    return {'ok': True, 'status':'resumed', 'run_id': run_id}

@app.post('/runs/{run_id}/cancel')
async def cancel_run(run_id: str, request: Request):
    require_api_key(request)
    r = store.get_run(run_id)
    if not r: raise HTTPException(status_code=404, detail='not found')
    store.mark_cancelled(run_id)
    return {'ok': True, 'status':'cancelled', 'run_id': run_id}


