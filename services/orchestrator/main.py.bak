@app.get('/admin/export/histograms.csv')
async def export_histograms(dep=Depends(auth_dependency)):
    # Parse generate_latest() exposition to extract *_bucket lines and dump CSV
    expo = generate_latest().decode('utf-8', errors='ignore')
    buf = io.StringIO()
    w = csv.writer(buf)
    w.writerow(["metric","le","count"])
    for line in expo.splitlines():
        if line.startswith("orch_step_duration_seconds_bucket") or line.startswith("orch_lease_wait_seconds_bucket"):
            try:
                name = line.split("_bucket{")[0]
                le = line.split('le="')[1].split('"')[0]
                count = line.split("} ")[1]
                w.writerow([name, le, count])
            except Exception:
                continue
    return Response(content=buf.getvalue(), media_type="text/csv")


@app.get('/admin/metrics/lease_wait_breakdown')
async def lease_wait_breakdown(dep=Depends(auth_dependency)):
    db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
    buckets = [0.001,0.01,0.05,0.1,0.25,0.5,1,2,5,10]
    out = {}
    async with aiosqlite.connect(db_path) as db:
        async with db.execute("SELECT tool, seconds FROM lease_wait_samples") as cur:
            async for tool,sec in cur:
                # find bucket
                b = next((b for b in buckets if sec <= b), "inf")
                out.setdefault(tool, {}).setdefault(str(b), 0)
                out[tool][str(b)] += 1
    return {"buckets": buckets, "counts": out}


@app.get('/admin/export/run_timeline/{run_id}.csv')
async def export_run_timeline(run_id: str, dep=Depends(auth_dependency)):
    db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
    buf = io.StringIO(); w = csv.writer(buf)
    w.writerow(["step_id","started_at","ended_at","duration_sec"])
    async with aiosqlite.connect(db_path) as db:
        async with db.execute("SELECT step_id, started_at, ended_at FROM executions WHERE run_id=?", (run_id,)) as cur:
            async for step_id, st, en in cur:
                dur = (en - st) if (st and en) else None
                w.writerow([step_id, st, en, dur])
    return Response(content=buf.getvalue(), media_type="text/csv")


@app.get('/admin/trace/{trace_id}')
async def get_trace(trace_id: str, dep=Depends(auth_dependency)):
    base = os.getenv('TRACE_API_BASE','').rstrip('/')
    if not base:
        raise HTTPException(status_code=501, detail="TRACE_API_BASE not configured")
    url = f"{base}/{trace_id}"
    async with aiohttp.ClientSession() as sess:
        async with sess.get(url) as r:
            if r.status != 200:
                raise HTTPException(status_code=r.status, detail=await r.text())
            data = await r.text()
            return Response(content=data, media_type=r.headers.get("content-type","application/json"))


