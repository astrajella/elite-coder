@app.get('/admin/metrics/durations_series')
async def durations_series(limit: int = 200, dep=Depends(auth_dependency)):
    db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
    rows = []
    async with aiosqlite.connect(db_path) as db:
        # derive duration from executions
        async with db.execute("SELECT started_at, ended_at FROM executions WHERE started_at IS NOT NULL AND ended_at IS NOT NULL ORDER BY ended_at DESC LIMIT ?", (limit,)) as cur:
            async for st, en in cur:
                rows.append({"ts": int(en), "duration": float(en - st)})
    rows.sort(key=lambda r: r["ts"])
    return {"points": rows}


@app.get('/admin/trace/{trace_id}/spans')
async def get_trace_spans(trace_id: str, dep=Depends(auth_dependency)):
    """Return spans for a trace_id using local executions table as source of truth.
    Falls back to synthetic spans if schema lacks columns.
    """
    db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
    rows = []
    async with aiosqlite.connect(db_path) as db:
        # Try to read rich execution info; many schemas will have these columns
        try:
            q = """
            SELECT e.id, e.trace_id, e.step_id, e.tool, e.persona, e.started_at, e.ended_at
            FROM executions e
            WHERE e.trace_id = ? AND e.started_at IS NOT NULL AND e.ended_at IS NOT NULL
            ORDER BY e.started_at ASC
            """
            async with db.execute(q, (trace_id,)) as cur:
                async for span_id, t_id, step_id, tool, persona, st, en in cur:
                    dur = float(en - st)
                    rows.append({
                        "span_id": str(span_id),
                        "trace_id": t_id,
                        "name": f"{tool or 'step'}:{step_id}",
                        "tool": tool,
                        "persona": persona or "unknown",
                        "start": float(st),
                        "end": float(en),
                        "duration": dur
                    })
        except Exception:
            # Fallback to any executions for that trace
            try:
                q = "SELECT id, started_at, ended_at FROM executions WHERE trace_id = ?"
                async with db.execute(q, (trace_id,)) as cur:
                    async for span_id, st, en in cur:
                        if st is None or en is None: 
                            continue
                        rows.append({
                            "span_id": str(span_id),
                            "trace_id": trace_id,
                            "name": f"exec:{span_id}",
                            "tool": None,
                            "persona": "unknown",
                            "start": float(st),
                            "end": float(en),
                            "duration": float(en-st)
                        })
            except Exception:
                pass
    # Normalize & compute relative offsets
    if rows:
        t0 = min(r["start"] for r in rows)
        for r in rows:
            r["offset"] = r["start"] - t0
    return {"spans": rows}


@app.get('/admin/export/trace_spans.csv')
async def export_trace_spans(trace_id: str, dep=Depends(auth_dependency)):
    db_path = os.getenv('ORCH_QUEUE_DB','/tmp/orchestrator_queue.db')
    buf = io.StringIO(); w = csv.writer(buf)
    w.writerow(["span_id","trace_id","name","tool","persona","start","end","duration","offset"])
    # Reuse API to avoid dup logic
    from fastapi import Request
    data = await get_trace_spans(trace_id)
    for s in data.get("spans", []):
        w.writerow([s.get("span_id"), s.get("trace_id"), s.get("name"), s.get("tool"), s.get("persona"),
                    s.get("start"), s.get("end"), s.get("duration"), s.get("offset")])
    return Response(content=buf.getvalue(), media_type="text/csv")


def _compute_critical_path(spans):
    """Given spans with start,end,duration, compute a max-duration non-overlapping chain.
    Uses weighted interval scheduling DP on (end) sorted spans.
    Returns indices of chosen spans in input order.
    """
    if not spans:
        return []
    # Sort spans by end time, but keep original reference
    order = sorted(range(len(spans)), key=lambda i: spans[i]["end"])
    ends = [spans[i]["end"] for i in order]
    # p(j): rightmost i < j with spans[order[i]].end <= spans[order[j]].start
    import bisect
    starts_sorted = [spans[i]["start"] for i in order]
    p = []
    for j, idx in enumerate(order):
        # find rightmost end <= start_j
        sj = spans[idx]["start"]
        i = bisect.bisect_right(ends, sj) - 1
        p.append(i)
    # DP
    n = len(order)
    M = [0.0]*(n+1)
    choose = [False]*n
    for j in range(1, n+1):
        w = spans[order[j-1]]["duration"]
        if p[j-1] >= 0:
            incl = w + M[p[j-1]+1]
        else:
            incl = w
        excl = M[j-1]
        if incl >= excl:
            M[j] = incl
            choose[j-1] = True
        else:
            M[j] = excl
            choose[j-1] = False
    # Recover solution
    res = []
    j = n
    while j > 0:
        if choose[j-1]:
            res.append(order[j-1])
            j = p[j-1] + 1
        else:
            j -= 1
    res.reverse()
    return res

@app.get('/admin/trace/{trace_id}/critical_path')
async def get_critical_path(trace_id: str, dep=Depends(auth_dependency)):
    base = await get_trace_spans(trace_id)
    spans = base.get("spans", [])
    idxs = _compute_critical_path(spans)
    path = [spans[i] for i in idxs]
    total = sum(s.get("duration",0.0) for s in path)
    return {"total_duration": total, "count": len(path), "spans": path}

@app.get('/admin/export/critical_path.csv')
async def export_critical_path(trace_id: str, dep=Depends(auth_dependency)):
    data = await get_critical_path(trace_id)
    buf = io.StringIO(); w = csv.writer(buf)
    w.writerow(["span_id","trace_id","name","tool","persona","start","end","duration","offset"])
    for s in data.get("spans", []):
        w.writerow([s.get("span_id"), s.get("trace_id"), s.get("name"), s.get("tool"), s.get("persona"),
                    s.get("start"), s.get("end"), s.get("duration"), s.get("offset")])
    return Response(content=buf.getvalue(), media_type="text/csv")

