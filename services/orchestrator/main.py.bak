from fastapi import Depends, HTTPException, status
from fastapi.security import APIKeyHeader, HTTPBearer, HTTPAuthorizationCredentials
import os, time, hmac, hashlib, base64, json

API_KEY_HEADER = APIKeyHeader(name="X-API-Key", auto_error=False)
HTTP_BEARER = HTTPBearer(auto_error=False)

def _consttime_eq(a,b):
    return hmac.compare_digest(str(a or ''), str(b or ''))

def _jwt_decode(token: str, secret: str):
    try:
        header_b64, payload_b64, sig_b64 = token.split('.')
        def _b64d(s):
            s += '=' * (-len(s) % 4)
            return base64.urlsafe_b64decode(s.encode())
        signing_input = f"{header_b64}.{payload_b64}".encode()
        sig = base64.urlsafe_b64decode(sig_b64 + '==')
        expect = hmac.new(secret.encode(), signing_input, hashlib.sha256).digest()
        if not hmac.compare_digest(sig, expect):
            return None
        payload = json.loads(_b64d(payload_b64))
        if payload.get('exp') and time.time() > payload['exp']:
            return None
        return payload
    except Exception:
        return None

async def auth_dependency(api_key: str = Depends(API_KEY_HEADER), bearer: HTTPAuthorizationCredentials = Depends(HTTP_BEARER)):
    required_key = os.getenv('ORCH_API_KEY')
    jwt_secret = os.getenv('ORCH_JWT_SECRET')
    if required_key and api_key and _consttime_eq(api_key, required_key):
        return {'mode':'api_key'}
    if bearer and jwt_secret:
        payload = _jwt_decode(bearer.credentials, jwt_secret)
        if payload:
            return {'mode':'jwt', 'sub':payload.get('sub')}
    if required_key or jwt_secret:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Unauthorized")
    return {'mode':'open'}
