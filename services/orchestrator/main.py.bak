class PlanStep(BaseModel):
    step_id: Optional[str]
    description: str
    persona: Optional[str] = 'coder'
    tool: Optional[str] = 'generate_code'
    payload: dict = {}
    expected_schema: Optional[str] = None
    idempotency_key: Optional[str] = None

class PlanSchema(BaseModel):
    plan_id: Optional[str]
    steps: List[PlanStep]
    project: Optional[str] = None
    @validator('steps')
    def non_empty(cls, v):
        if not v:
            raise ValueError('plan must contain at least one step')
        return v

import os
ORCH_API_KEY = os.getenv('ORCH_API_KEY','')

def require_api_key(request):
    if not ORCH_API_KEY:
        return # no key configured
    key = request.headers.get('x-orch-api-key') or request.headers.get('authorization')
    if not key:
        raise HTTPException(status_code=401, detail='missing api key')
    # support Bearer token in Authorization
    if key.lower().startswith('bearer '):
        key = key.split(' ',1)[1]
    if key != ORCH_API_KEY:
        raise HTTPException(status_code=403, detail='invalid api key')
