@app.get('/admin/export/run_steps/{run_id}.ndjson')
async def export_run_steps_ndjson(run_id: str, dep=Depends(auth_dependency)):
    rows = await queue_sqlite.step_list(run_id)
    def gen():
        for r in rows:
            yield json.dumps(r) + "\n"
    return StreamingResponse(gen(), media_type='application/x-ndjson')

@app.get('/admin/export/run_steps/{run_id}.csv')
async def export_run_steps_csv(run_id: str, dep=Depends(auth_dependency)):
    rows = await queue_sqlite.step_list(run_id)
    def gen():
        import io
        buf = io.StringIO()
        if rows:
            writer = csv.DictWriter(buf, fieldnames=list(rows[0].keys()))
            writer.writeheader()
            for r in rows:
                writer.writerow(r)
                yield buf.getvalue(); buf.seek(0); buf.truncate(0)
        else:
            yield ""
    return StreamingResponse(gen(), media_type='text/csv')


