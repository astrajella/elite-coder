@app.get("/metrics")
def metrics():
    return Response(generate_latest(), media_type=CONTENT_TYPE_LATEST)



def _call_tool(tool_name, fn, payload):
    """Wrap a tool call to emit metrics, enforce schema validation, and support async functions."""
    import asyncio, time as _time
    is_coro = asyncio.iscoroutinefunction(fn)
    start = _time.perf_counter()
    try:
        if is_coro:
            result = asyncio.get_event_loop().run_until_complete(fn(payload))
        else:
            result = fn(payload)
        # success metric
        try:
            ORCH_TOOL_CALLS.labels(tool=tool_name, status="success").inc()
        except Exception:
            pass
        return result
    except Exception as e:
        # failure metric
        try:
            ORCH_TOOL_CALLS.labels(tool=tool_name, status="failure").inc()
        except Exception:
            pass
        raise
    finally:
        try:
            dur = _time.perf_counter() - start
            ORCH_STEP_LATENCY.labels(step=f"tool:{tool_name}").observe(dur)
        except Exception:
            pass
